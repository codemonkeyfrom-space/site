---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';
---

<header>
	<nav>
		<div>
			<h2 style="display: flex; align-items: center; gap: 0.5rem;">
				<img src='/code-monkey-from-space.svg' style="max-height: 50px; max-width: 50px;"/>
				<a href="/" style="top:0px; position: relative;vertical-align: centre;">{SITE_TITLE}</a>
			</h2>
		</div>
		<div class="internal-links">
			<HeaderLink href="/">Home</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
			<HeaderLink href="/about">About</HeaderLink>
		</div>
	</nav>
</header>
<style>
	header {
		margin: 0;
		padding: 0 1em;
		background: #000;
		color: #bbb;
		box-shadow: 0 2px 8px rgba(var(--black), 5%);
	}
	h2 {
		margin: 0;
		font-size: 1em;
		color: #bbb;
	}

	h2 a,
	h2 a.active {
		text-decoration: none;
		color: #bbb;
	}
	nav {
		display: flex;
		align-items: center;
		justify-content: space-between;
		color: #bbb;
	}
	nav a {
		padding: 1em 0.5em;
		border-bottom: 4px solid transparent;
		text-decoration: none;
		color: #bbb;
	}
	nav a.active {
		text-decoration: none;
		border-bottom-color: var(--accent);
	}
	.social-links,
	.social-links a {
		display: flex;
		color: #ccc;
	}
	@media (max-width: 720px) {
		.social-links {
			display: none;
		}
	}
</style>
