---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<!-- Google Tag Manager -->
		<script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
			new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
			j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
			'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
			})(window,document,'script','dataLayer','GTM-W4K29XRX');</script>
			<!-- End Google Tag Manager -->

		

		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	
	<body>
		<!-- Google Tag Manager (noscript) -->
		<noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-W4K29XRX"
			height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
			<!-- End Google Tag Manager (noscript) -->

		<Header />
		<main>
			<h1>
				This is CodeMonkeyFromSpace.com
			</h1>
			<p>
				You can learn a lot from a monkey from space. 
				That's why we've started this website and blog. 
				To help people learn.
			</p>

			<h2>What is there to do here?</h2>
			<p>
				There are a few things to do, other than just clicking all the pages and reading them.
				There are some interactive web pages involving <a href="/blog/marked-chessboard">chess</a>, 
				<a href='/blog/conways-game-of-life/'>cellular automata</a>, <a href="/blog/ga4tsp">genetic algorithms</a> and other fun stuff. 
				If you're curious about any of that kind of thing, the best place to start is the <a href="/blog">blog</a>.
			</p>
		</main>
		<div class="rightMenu">
			<h5>Recent blog posts</h5>
			<section>
					{
						posts.map((post) => (
								<a href={`/blog/${post.id}/`}>
									<p class="date">

										{post.data.title}
									</p>
								</a>
						))
					}
			</section>
		</div>
		<Footer />
	</body>
</html>
