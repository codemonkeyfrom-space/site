---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Header />
		<main>
			<h1>
				This is CodeMonkeyFrom.Space</h1>
			<p>
				You can learn a lot from a monkey from space. That's why we've started this website and blog. To help people learn.
			</p>
			<p>
				There are a few things to do around here.
				Mostly reading, but there are also some interactive web pages involving <a href="/blog/marked-chessboard">chess</a>, 
				<a href='/blog/conways-game-of-life/'>cellular automata</a>, and other fun stuff like that. 
				If you're curious about any of that, the best place to start is at our <a href="/blog">blog</a>.
			</p>

		</main >
		<Footer />
	</body>
</html>
